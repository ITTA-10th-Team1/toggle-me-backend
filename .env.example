# 로컬 개발용 환경 변수 예시
# 사용법: 이 파일을 복사해 .env를 만들고 값을 채운다 (cp .env.example .env)
# .env는 git에 올리지 않는다

DB_PORT=3306
DB_NAME=toggleme
DB_USERNAME=toggleme
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Base64 인코딩된 32바이트 이상 키 (생성: openssl rand -base64 32)
JWT_SECRET=

# 카카오 개발자 콘솔 > 앱 키 > 앱 ID (숫자)
KAKAO_APP_ID=

# 앱인토스 콘솔 > 개발 > mTLS 인증서에서 받은 파일의 경로. 저장소 밖에 두고 개인 키는 커밋하지 않는다. 테스트만 돌릴 때는 비워도 된다
TOSS_MTLS_CERT_PATH=
TOSS_MTLS_KEY_PATH=
# 앱인토스 콘솔의 연결 끊기 콜백에 등록할 Basic Auth 값(우리가 정한다). 긴 무작위 값을 쓰고 커밋하지 않는다
TOSS_CALLBACK_USERNAME=
TOSS_CALLBACK_PASSWORD=

# Google AI Studio API 키 (이미지 분석). 테스트만 돌릴 때는 아무 값이나 넣어도 된다
GEMINI_API_KEY=

# NCP 콘솔 > NAVER API HUB > Application의 Client ID·Secret (냉장고 AI 추천의 음식 사진). 테스트만 돌릴 때는 비워도 된다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 운영 서버 .env 항목은 docs/workflows/deployment.md 참고
