# 로컬 개발용 환경 변수 예시
# 사용법: 이 파일을 복사해 .env를 만들고 값을 채운다 (cp .env.example .env)
# .env는 git에 올리지 않는다

DB_PORT=3306
DB_NAME=toggleme
DB_USERNAME=toggleme
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Base64 인코딩된 32바이트 이상 키 (생성: openssl rand -base64 32)
JWT_SECRET=

# 카카오 개발자 콘솔 > 앱 키 > 앱 ID (숫자)
KAKAO_APP_ID=
# 카카오 개발자 콘솔 > 앱 키 > REST API 키 (책장 AI 추천의 책 검색). 서버 전용이라 앱에 공유하지 않는다. 테스트만 돌릴 때는 비워도 된다
KAKAO_REST_API_KEY=

# Google AI Studio API 키 (이미지 분석). 테스트만 돌릴 때는 아무 값이나 넣어도 된다
GEMINI_API_KEY=

# NCP 콘솔 > NAVER API HUB > Application의 Client ID·Secret (냉장고 AI 추천의 음식 사진). 테스트만 돌릴 때는 비워도 된다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이메일 인증 메일 발송(Gmail SMTP). MAIL_USERNAME이 비어 있으면 메일 대신 서버 로그에 인증 코드가 찍힌다(로컬 개발용)
# MAIL_PASSWORD는 Google 계정 2단계 인증 후 만든 "앱 비밀번호" 16자리다. 서버 전용이라 공유·커밋하지 않는다
MAIL_USERNAME=
MAIL_PASSWORD=

# 관리자 대시보드(/admin.html) HTTP Basic 계정. 둘 다 비어 있으면 접근할 수 없다
ADMIN_DASHBOARD_USERNAME=
ADMIN_DASHBOARD_PASSWORD=

# 운영 서버 .env 항목은 docs/workflows/deployment.md 참고
